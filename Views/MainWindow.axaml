<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Diagramon.ViewModels"
        xmlns:models="using:Diagramon.Models"
        xmlns:views="using:Diagramon.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="Diagramon.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:Name="root"
        Title="{Binding WindowTitle}"
        Icon="/Assets/diagramon32.ico"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="600"
        Closed="OnClosed">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>



    <Grid RowDefinitions="Auto,*,Auto">
        <Menu Grid.Row="0">
            <MenuItem Header="{Binding MenuFile}">
                <MenuItem Header="{Binding MenuNew}" InputGesture="Ctrl+N" Command="{Binding NewFileCommand}"/>
                <MenuItem Header="{Binding MenuOpen}" InputGesture="Ctrl+O" Command="{Binding OpenFileCommand}"/>
                <MenuItem Header="{Binding MenuRecentFiles}" IsEnabled="{Binding HasRecentFiles}"
                          ItemsSource="{Binding RecentFiles}">
                    <MenuItem.ItemTemplate>
                        <DataTemplate x:DataType="models:RecentFileItem">
                            <MenuItem Header="{Binding DisplayName}"
                                      ToolTip.Tip="{Binding DisplayPath}"
                                      Command="{Binding #root.DataContext.OpenRecentFileCommand}"
                                      CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </MenuItem.ItemTemplate>
                </MenuItem>
                <Separator IsVisible="{Binding Auth.Session.IsCloudEntryVisible}"/>
                <MenuItem Header="{Binding CloudSaveToCloud}"
                          IsVisible="{Binding Auth.Session.IsCloudEntryVisible}"
                          Command="{Binding SaveToCloudCommand}"/>
                <MenuItem Header="{Binding CloudDocuments}"
                          IsVisible="{Binding Auth.Session.IsCloudEntryVisible}"
                          Command="{Binding OpenFromCloudCommand}"/>
                <Separator/>
                <MenuItem Header="{Binding MenuSave}" InputGesture="Ctrl+S" Command="{Binding SaveFileCommand}"/>
                <MenuItem Header="{Binding MenuSaveAs}" InputGesture="Ctrl+Shift+S" Command="{Binding SaveFileAsCommand}"/>
                <Separator/>
                <MenuItem Header="{Binding MenuCloseTab}" InputGesture="Ctrl+W" Command="{Binding CloseCurrentTabCommand}"/>
                <Separator/>
                <MenuItem Header="{Binding MenuSettings}">
                    <MenuItem Header="{Binding MenuAISettings}" Command="{Binding OpenAISettingsCommand}"/>
                    <MenuItem Header="{Binding MenuImageScaleSettings}" Command="{Binding OpenImageScaleSettingsCommand}"/>
                    <MenuItem Header="{Binding LanguageMenu}" ItemsSource="{Binding AvailableLanguages}">
                        <MenuItem.ItemTemplate>
                            <DataTemplate>
                                <MenuItem Header="{Binding Value.NativeName}"
                                          Command="{Binding #root.DataContext.SetLanguageCommand}"
                                          CommandParameter="{Binding Key}"/>
                            </DataTemplate>
                        </MenuItem.ItemTemplate>
                    </MenuItem>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{Binding MenuExit}" InputGesture="Ctrl+Q" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="{Binding MenuEdit}">
                <MenuItem Header="{Binding MenuUndo}" InputGesture="Ctrl+Z" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndoAction}"/>
                <MenuItem Header="{Binding MenuRedo}" InputGesture="Ctrl+Y" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedoAction}"/>
                <Separator/>
                <MenuItem Header="{Binding MenuCut}" InputGesture="Ctrl+X" Command="{Binding CutCommand}" IsEnabled="{Binding CanCutAction}"/>
                <MenuItem Header="{Binding MenuCopy}" InputGesture="Ctrl+C" Command="{Binding CopyCommand}" IsEnabled="{Binding CanCopyAction}"/>
                <MenuItem Header="{Binding MenuPaste}" InputGesture="Ctrl+V" Command="{Binding PasteCommand}" IsEnabled="{Binding CanPasteAction}"/>
                <MenuItem Header="{Binding MenuSelectAll}" InputGesture="Ctrl+A" Command="{Binding SelectAllCommand}" IsEnabled="{Binding CanSelectAllAction}"/>
            </MenuItem>
            <MenuItem Header="{Binding MenuAccount}">
                <MenuItem Header="{Binding MenuSignIn}"
                          IsVisible="{Binding !Auth.Session.IsSignedIn}"
                          Command="{Binding ShowLoginCommand}"/>
                <MenuItem Header="{Binding MenuSignOut}"
                          IsVisible="{Binding Auth.Session.IsSignedIn}"
                          Command="{Binding SignOutCommand}"/>
                <Separator IsVisible="{Binding Auth.Session.IsSignedIn}"/>
                <MenuItem Header="{Binding AccountDisplayName}"
                          IsVisible="{Binding Auth.Session.IsSignedIn}"
                          IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="{Binding MenuHelp}">
                <MenuItem Header="{Binding MenuMermaidDocs}" Command="{Binding OpenMermaidDocsCommand}"/>
                <Separator/>
                <MenuItem Header="{Binding MenuCheckUpdate}" Command="{Binding CheckUpdateCommand}"/>
                <MenuItem Header="{Binding MenuAbout}" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Border Grid.Row="0" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" ClipToBounds="True"
                    PointerWheelChanged="OnTabPointerWheelChanged">
                <StackPanel Orientation="Horizontal">
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:TabItem">
                                <Border Background="{Binding IsSelected, Converter={x:Static vm:MainViewModel.TabBackgroundConverter}}"
                                        BorderBrush="#CCCCCC" BorderThickness="1,1,1,0"
                                        CornerRadius="4,4,0,0"
                                        Padding="10,5"
                                        Margin="2,0,-1,0"
                                        PointerPressed="OnTabPointerPressed"
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Foreground="#333333"
                                                   FontWeight="{Binding IsSelected, Converter={x:Static vm:MainViewModel.TabFontWeightConverter}}"/>
                                        <Button Content="x" 
                                                Width="18" Height="18"
                                                Padding="0"
                                                FontSize="12"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).CloseTabCommand}"
                                                CommandParameter="{Binding}"
                                                ClickMode="Release"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="+" 
                            Width="28" Height="28"
                            Margin="4,0,5,0"
                            FontSize="16"
                            FontWeight="Bold"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Command="{Binding AddNewTabCommand}"
                            ToolTip.Tip="{Binding NewTabTooltip}"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="#FFFFFF">
                <Grid x:Name="WorkspaceGrid" ColumnDefinitions="Auto,Auto,*" SizeChanged="OnWorkspaceSizeChanged" ClipToBounds="False">
                    <Border Grid.Column="0" Background="#FFFFFF" Width="{Binding EditorPanelWidth}" MinWidth="0"
                            IsVisible="{Binding IsEditorVisible}">
                        <Grid RowDefinitions="*,Auto,Auto">
                             <avaloniaEdit:TextEditor Grid.Row="0" x:Name="CodeEditor"
                                                      Document="{Binding #root.DataContext.CurrentTab.Document}"
                                                      SyntaxHighlighting="{Binding MermaidHighlighting}"
                                                      FontFamily="JetBrains Mono,Cascadia Code,Fira Code,Consolas,Menlo,Monaco,monospace"
                                                      FontSize="14"
                                                      Background="#FFFFFF"
                                                      Foreground="#333333"
                                                      BorderThickness="0"
                                                      ShowLineNumbers="True"
                                                      WordWrap="True"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Auto">
                                <avaloniaEdit:TextEditor.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding #root.DataContext.MenuUndo}" InputGesture="Ctrl+Z" Command="{Binding #root.DataContext.UndoCommand}" IsEnabled="{Binding #root.DataContext.CanUndoAction}"/>
                                        <MenuItem Header="{Binding #root.DataContext.MenuRedo}" InputGesture="Ctrl+Y" Command="{Binding #root.DataContext.RedoCommand}" IsEnabled="{Binding #root.DataContext.CanRedoAction}"/>
                                        <Separator/>
                                        <MenuItem Header="{Binding #root.DataContext.MenuCut}" InputGesture="Ctrl+X" Command="{Binding #root.DataContext.CutCommand}" IsEnabled="{Binding #root.DataContext.CanCutAction}"/>
                                        <MenuItem Header="{Binding #root.DataContext.MenuCopy}" InputGesture="Ctrl+C" Command="{Binding #root.DataContext.CopyCommand}" IsEnabled="{Binding #root.DataContext.CanCopyAction}"/>
                                        <MenuItem Header="{Binding #root.DataContext.MenuPaste}" InputGesture="Ctrl+V" Command="{Binding #root.DataContext.PasteCommand}" IsEnabled="{Binding #root.DataContext.CanPasteAction}"/>
                                        <Separator/>
                                        <MenuItem Header="{Binding #root.DataContext.MenuSelectAll}" InputGesture="Ctrl+A" Command="{Binding #root.DataContext.SelectAllCommand}" IsEnabled="{Binding #root.DataContext.CanSelectAllAction}"/>
                                    </ContextMenu>
                                </avaloniaEdit:TextEditor.ContextMenu>
                            </avaloniaEdit:TextEditor>

                            <Border Grid.Row="1" Background="#E8E8E8" Height="4"
                                    IsVisible="{Binding AiAssistant.IsExpanded}"
                                    Cursor="SizeNorthSouth"
                                    PointerPressed="OnAIPanelSplitterPointerPressed"
                                    PointerMoved="OnAIPanelSplitterPointerMoved"
                                    PointerReleased="OnAIPanelSplitterPointerReleased">
                                <Border Width="30" Height="3" Background="#C0C0C0" CornerRadius="1.5"
                                        VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>

                            <Border Grid.Row="2" Background="#F8F8F8" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"
                                    MinHeight="50"
                                    Height="{Binding AiAssistant.PanelHeight}"
                                    IsVisible="{Binding AiAssistant.IsExpanded}">
                                <views:AIPanel DataContext="{Binding AiAssistant}"/>
                            </Border>

                            <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"
                                    Height="28" Padding="8,4"
                                    IsVisible="{Binding !AiAssistant.IsExpanded}"
                                    Cursor="Hand"
                                    PointerPressed="OnAIPanelTogglePointerPressed">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="{Binding AiAssistant.ToggleButtonText}"
                                               FontWeight="SemiBold" FontSize="12" Foreground="#333333"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AiAssistant.StatusMessage}"
                                               HorizontalAlignment="Right" FontSize="11" Foreground="#888888"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border x:Name="SplitterBorder"
                            Grid.Column="1"
                            Width="6"
                            Background="#E0E0E0"
                            Cursor="SizeWestEast"
                            PointerPressed="OnSplitterPointerPressed"
                            PointerMoved="OnSplitterPointerMoved"
                            PointerReleased="OnSplitterPointerReleased"/>

                    <Border Grid.Column="1"
                            ZIndex="10"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Width="12" Height="24"
                            Background="#D6D6D6"
                            CornerRadius="4"
                            Cursor="Hand"
                            Tapped="OnToggleTriangleTapped">
                        <Grid Width="4" Height="8">
                            <Path Data="M 0,0 L 4,4 L 0,8 Z"
                                  Fill="#999999"
                                  IsVisible="{Binding !IsEditorVisible}"/>
                            <Path Data="M 4,0 L 0,4 L 4,8 Z"
                                  Fill="#999999"
                                  IsVisible="{Binding IsEditorVisible}"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="#F8F8F8" MinWidth="480">
                        <Grid>
                            <Border x:Name="PreviewGrid"
                                    Background="#F8F8F8"
                                    ClipToBounds="True">
                                <Border x:Name="PreviewWebHost"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Background="#FFFFFF"
                                        BorderThickness="0"/>
                            </Border>

                            <Popup IsOpen="True"
                                   IsLightDismissEnabled="False"
                                   Placement="AnchorAndGravity"
                                   PlacementTarget="{Binding #PreviewGrid}"
                                   PlacementAnchor="TopRight"
                                   PlacementGravity="BottomLeft"
                                   HorizontalOffset="-12"
                                   VerticalOffset="12">
                                <Border Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="6"
                                        Padding="4">
                                    <StackPanel Spacing="6">
                                        <Button Width="32"
                                                Height="32"
                                                Padding="0"
                                                Command="{Binding SaveImageCommand}"
                                                ToolTip.Tip="{Binding SavePreviewImage}">
                                            <Path Width="15"
                                                  Height="15"
                                                  Stretch="Uniform"
                                                  Fill="#444444"
                                                  Data="M3,2 H13 L16,5 V16 H3 Z M5,2 V7 H11 V2 M6,16 V11 H13 V16 Z"/>
                                        </Button>
                                        <Button Width="32"
                                                Height="32"
                                                Padding="0"
                                                Command="{Binding CopyImageCommand}"
                                                ToolTip.Tip="{Binding CopyPreviewImage}">
                                            <Path Width="15"
                                                  Height="15"
                                                  Stretch="Uniform"
                                                  Fill="#444444"
                                                  Data="M5,2 H13 A2,2 0 0 1 15,4 V12 H13 V4 H5 Z M2,5 H10 A2,2 0 0 1 12,7 V15 A2,2 0 0 1 10,17 H4 A2,2 0 0 1 2,15 Z"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="5,2">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#666666" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding ZoomText}" Foreground="#666666" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
