<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\diagramon32.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- <PublishTrimmed>true</PublishTrimmed> -->
    <Version>2.0.260909.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.260.909</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.0" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.4.1" />
    <PackageReference Include="WebView.Avalonia" Version="11.0.0.1" />
    <PackageReference Include="WebView.Avalonia.Desktop" Version="11.0.0.1" />
    <!-- Override transitive dependency to fix GHSA-xrw6-gwf8-vvr9 -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.93.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- tools/ is packaging resource (bundled node/mermaid CLI); its node_modules contains .cs files that must be excluded from compilation -->
    <Compile Remove="tools\**" />
    <AvaloniaResource Include="Assets\**" />
    <Content Include="Assets\Languages\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="tools\**" Exclude="tools\node_modules\**\*.map;tools\node_modules\**\*.d.ts">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- Workaround: Avalonia 11.3.0 path handling fails on .NET 10 SDK with mixed \/ path separators -->
  <PropertyGroup>
    <AvaloniaResourcesTemporaryFilePath>$(IntermediateOutputPath)Avalonia\resources</AvaloniaResourcesTemporaryFilePath>
    <_AvaloniaResourcesInputsCacheFilePath>$(IntermediateOutputPath)Avalonia\Resources.Inputs.cache</_AvaloniaResourcesInputsCacheFilePath>
  </PropertyGroup>
  <Target Name="CreateAvaloniaAvaloniaDir" BeforeTargets="_GenerateAvaloniaResourcesDependencyCache">
    <Exec Command="mkdir &quot;$(IntermediateOutputPath)Avalonia\resources&quot; 2>nul" IgnoreExitCode="true" />
  </Target>

  <!-- Workaround: framework-dependent builds (Debug) don't copy native WebView2Loader.dll from NuGet -->
  <Target Name="CopyWebView2LoaderNative" AfterTargets="Build" Condition="!Exists('$(OutputPath)WebView2Loader.dll') And '$(OS)' == 'Windows_NT'">
    <Copy SourceFiles="$(NuGetPackageRoot)webview.avalonia.windows\11.0.0.1\runtimes\win-x64\native\WebView2Loader.dll"
          DestinationFolder="$(OutputPath)" />
  </Target>
</Project>
