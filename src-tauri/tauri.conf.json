{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diagramon",
  "identifier": "com.diagramon.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": [
          "mmd",
          "mermaid"
        ],
        "name": "Diagramon Mermaid",
        "description": "Mermaid 图表（Diagramon）",
        "role": "Editor",
        "mimeType": "text/x-mermaid"
      },
      {
        "ext": [
          "dot",
          "gv"
        ],
        "name": "Diagramon Graphviz DOT",
        "description": "Graphviz DOT 图表（Diagramon）",
        "role": "Editor",
        "mimeType": "text/vnd.graphviz"
      },
      {
        "ext": [
          "d2"
        ],
        "name": "Diagramon D2",
        "description": "D2 图表（Diagramon）",
        "role": "Editor",
        "mimeType": "text/x-d2"
      },
      {
        "ext": [
          "drawio"
        ],
        "name": "Diagramon drawio",
        "description": "drawio 图表（Diagramon）",
        "role": "Editor",
        "mimeType": "application/x-drawio"
      },
      {
        "ext": [
          "excalidraw"
        ],
        "name": "Diagramon Excalidraw",
        "description": "Excalidraw 场景（Diagramon）",
        "role": "Editor",
        "mimeType": "application/vnd.excalidraw+json"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "AI 优先的多格式图表编辑器",
    "longDescription": "Diagramon：本地优先的多格式图表编辑器。Mermaid / Graphviz DOT / D2 / drawio / Excalidraw 共用一套工作区，AI 是第一公民。",
    "resources": {
      "../ui/": "ui/",
      "../assets/": "assets/"
    },
    "macOS": {
      "minimumSystemVersion": "12.3"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerHooks": "nsis/installer.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libpipewire-0.3-0",
          "libgbm1",
          "libegl1",
          "libwayland-client0"
        ],
        "section": "devel",
        "files": {
          "/usr/share/mime/packages/diagramon.xml": "linux/diagramon-mime.xml"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2NDQ3OUFBRTE1NjMzOTkKUldTWk0xYmhxbmxFNWtpS1ZqQ21BQU55MXdtTUxReW52b3BOTWFrTzRJSHhBVTM2UWgvWENUZlIK",
      "endpoints": [
        "https://www.diagramon.com/updates/{{target}}/{{arch}}/{{current_version}}",
        "https://github.com/westsource/diagramon/releases/latest/download/latest.json"
      ]
    }
  }
}
