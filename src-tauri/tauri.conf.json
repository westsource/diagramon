{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diagramon",
  "identifier": "com.diagramon.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": [
          "mmd",
          "mermaid"
        ],
        "name": "Diagramon Mermaid",
        "description": "Mermaid 图表（Diagramon）",
        "role": "Editor"
      },
      {
        "ext": [
          "dot",
          "gv"
        ],
        "name": "Diagramon Graphviz DOT",
        "description": "Graphviz DOT 图表（Diagramon）",
        "role": "Editor"
      },
      {
        "ext": [
          "drawio"
        ],
        "name": "Diagramon drawio",
        "description": "drawio 图表（Diagramon）",
        "role": "Editor"
      },
      {
        "ext": [
          "excalidraw"
        ],
        "name": "Diagramon Excalidraw",
        "description": "Excalidraw 场景（Diagramon）",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "AI 优先的多格式图表编辑器",
    "longDescription": "Diagramon：本地优先的多格式图表编辑器。Mermaid / Graphviz DOT / drawio / Excalidraw 共用一套工作区，AI 是第一公民。",
    "resources": {
      "../ui/": "ui/",
      "../assets/": "assets/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2NDQ3OUFBRTE1NjMzOTkKUldTWk0xYmhxbmxFNWtpS1ZqQ21BQU55MXdtTUxReW52b3BOTWFrTzRJSHhBVTM2UWgvWENUZlIK",
      "endpoints": [
        "https://github.com/westsource/diagramon/releases/latest/download/latest.json",
        "https://www.diagramon.com/{{target}}/{{arch}}/{{current_version}}",
        "https://diagramon.agentctxsync.com/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
