{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diagramon",
  "version": "3.0.0",
  "identifier": "com.diagramon.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "fileAssociations": [
      { "ext": ["mmd", "mermaid"], "name": "Diagramon Mermaid", "description": "Mermaid 图表（Diagramon）", "role": "Editor" },
      { "ext": ["dot", "gv"], "name": "Diagramon Graphviz DOT", "description": "Graphviz DOT 图表（Diagramon）", "role": "Editor" },
      { "ext": ["drawio"], "name": "Diagramon drawio", "description": "drawio 图表（Diagramon）", "role": "Editor" },
      { "ext": ["excalidraw"], "name": "Diagramon Excalidraw", "description": "Excalidraw 场景（Diagramon）", "role": "Editor" }
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
