flowchart TD
    Start([用户触发]) --> CheckMethod{触发方式?}

    CheckMethod -->|菜单: 新建| CmdNew["MainViewModel.NewFile()"]
    CheckMethod -->|菜单: 打开| CmdOpen["MainViewModel.OpenFile()"]
    CheckMethod -->|命令行参数| CmdPath["MainViewModel.OpenFileFromPath(filePath)"]
    CheckMethod -->|最近文件| CmdRecent["MainViewModel.OpenRecentFile(item)"]

    CmdNew --> AddNewTab

    subgraph NewTabFlow[新建标签页]
        AddNewTab["AddNewTab()"]
        AddNewTab --> CreateDefault["new TabItem{Header='未命名.mmd',<br/>Content = GetDefaultMermaidCode()}"]
        CreateDefault --> SubscribeEvent["tab.ContentChanged += OnTabContentChanged"]
        SubscribeEvent --> AddToTabs["Tabs.Add(tab)"]
        AddToTabs --> SelectTab["SelectTab(Tabs.Count - 1, forceNotify: true)<br/>触发 SelectedTabIndex 变更"]
    end

    subgraph FileSelect[文件选择阶段]
        CmdOpen --> ShowDialog["FileService.OpenFileAsync()<br/>显示文件选择对话框"]
        ShowDialog --> SelectFile["选择 .mmd 文件"]
        SelectFile --> GetContent1["返回 (content, filePath)"]

        CmdPath --> TrySelect1{"TrySelectExistingTabByPath(filePath)<br/>文件是否已在标签页?"}
        TrySelect1 -->|是| Done1["StatusMessage = '文件已打开'"]
        TrySelect1 -->|否| ReadFile1["FileService.OpenFileFromPathAsync(filePath)<br/>直接读取指定路径文件"]
        ReadFile1 --> CheckContent1{"content != null?"}
        CheckContent1 -->|否| End([结束])
        CheckContent1 -->|是| CreateTab1

        CmdRecent --> CheckExists{"File.Exists(filePath)?"}
        CheckExists -->|否| RemoveRecent["RemoveFromRecentFiles(filePath)<br/>StatusMessage = '文件不存在'"]
        CheckExists -->|是| CheckTabOpen{"Tabs.FirstOrDefault(t => t.FilePath == filePath)<br/>文件是否已在标签?"}
        CheckTabOpen -->|是| SwitchTab["SelectedTabIndex = Tabs.IndexOf(existingTab)<br/>切换到已有标签"]
        CheckTabOpen -->|否| ReadFile2["FileService.OpenFileFromPathAsync(filePath)"]
        ReadFile2 --> CheckContent2{"content != null?"}
        CheckContent2 -->|否| End
        CheckContent2 -->|是| CreateTab1

        RemoveRecent --> End
        SwitchTab --> End
        Done1 --> End
    end

    GetContent1 --> TrySelect2{"TrySelectExistingTabByPath(filePath)"}
    TrySelect2 -->|是| Done1
    TrySelect2 -->|否| CreateTab1

    subgraph CreateTab[创建标签页]
        CreateTab1["new TabItem{Content = content, FilePath = filePath}"]
        CreateTab1 --> SubscribeEvent2["tab.ContentChanged += OnTabContentChanged"]
        SubscribeEvent2 --> UpdateHeader["tab.UpdateHeader()<br/>更新标签标题"]
        UpdateHeader --> AddToTabs2["Tabs.Add(tab)"]
        AddToTabs2 --> SetSelected["SelectedTabIndex = Tabs.Count - 1<br/>触发 OnSelectedTabIndexChanged"]
        SetSelected --> AddRecent["AddToRecentFiles(filePath)"]
    end

    AddRecent --> AddRecentImpl["RecentFiles.Insert(0, item)<br/>_settingsService.AddRecentFile(filePath)<br/>限制 MaxRecentFiles 数量"]
    AddRecentImpl --> OnSelectedChanged

    SelectTab --> OnSelectedChanged
    SetSelected --> OnSelectedChanged

    subgraph TabSwitch[标签切换]
        OnSelectedChanged["OnSelectedTabIndexChanged(value)"]
        OnSelectedChanged --> UpdateTabs["循环 Tabs: tab.IsSelected = (i == value)"]
        UpdateTabs --> ResetEditor["ResetEditorState()<br/>重置撤销/重做/剪贴板状态"]
        ResetEditor --> UpdatePreviewHtml["CurrentPreviewHtml = tab.WebPreviewHtml<br/>或空字符串"]
        UpdatePreviewHtml --> AiSetFile["AiAssistant?.SetCurrentFile(CurrentTab?.FilePath)"]
        AiSetFile --> ScheduleRender["ScheduleValidationAndRender(CurrentTab)"]
    end

    subgraph RenderFlow[验证与渲染]
        ScheduleRender --> CheckCurrent{"ReferenceEquals(tab, CurrentTab)?"}
        CheckCurrent -->|否| SkipRender([跳过])
        CheckCurrent -->|是| CancelActive["CancelActiveRender()<br/>取消上一轮渲染"]
        CancelActive --> Debounce["_debounceTimer 延时 350ms<br/>等待用户停止输入"]
        Debounce --> ValidateRender["ValidateAndRenderTab(tab)"]

        ValidateRender --> CheckEmpty{"string.IsNullOrWhiteSpace(tab.Content)?"}
        CheckEmpty -->|是| SetEmpty["CancelActiveRender()<br/>tab.WebPreviewHtml = BuildPreviewHtml('')<br/>tab.HasError = false<br/>CurrentPreviewHtml = 空HTML<br/>StatusMessage = '就绪'"]
        CheckEmpty -->|否| IncGeneration["_renderGeneration++<br/>创建 CancellationToken"]
        IncGeneration --> Delay["await Task.Delay(1, cancellationToken)"]
        Delay --> IsLatest1{"IsLatestRenderRequest(tab, contentSnapshot, generation)?"}
        IsLatest1 -->|否| SkipRender
        IsLatest1 -->|是| BuildHtml["tab.WebPreviewHtml = BuildPreviewHtml(content)<br/>tab.HasError = false"]
        BuildHtml --> UpdateHtml["CurrentPreviewHtml = tab.WebPreviewHtml<br/>StatusMessage = '预览已更新'"]
        UpdateHtml --> CancelToken["CancellationToken 取消时抛出<br/>OperationCanceledException 静默处理"]
    end

    SetEmpty --> PropertyChanged
    UpdateHtml --> PropertyChanged
    PropertyChanged["CurrentPreviewHtml PropertyChanged 事件"]

    subgraph WebViewRender[WebView 渲染]
        PropertyChanged --> OnVMChanged["MainWindow.OnViewModelPropertyChanged()<br/>e.PropertyName == CurrentPreviewHtml"]
        OnVMChanged --> UpdateWebPreview["UpdateWebPreview()"]

        UpdateWebPreview --> CheckHtmlEmpty{"CurrentPreviewHtml 为空?"}
        CheckHtmlEmpty -->|是| SkipWV([跳过])
        CheckHtmlEmpty -->|否| CheckContentEmpty{"CurrentTab.Content 为空<br/>且 WebView 未创建?"}
        CheckContentEmpty -->|是| SkipWV
        CheckContentEmpty -->|否| EnsureReady{"EnsureWebViewReady()?"}

        EnsureReady -->|失败| SetStatus["StatusMessage = 'WebView 初始化失败'"]
        EnsureReady -->|成功| CheckPageLoaded{"_webViewPageLoaded == true?"}

        CheckPageLoaded -->|是| ScriptUpdate["UpdatePreviewViaScript()"]
        CheckPageLoaded -->|否| FullReload["_pendingPreviewHtml = html<br/>TryApplyPendingWebPreview()"]
    end

    SetStatus --> SkipWV

    subgraph ScriptUpdateFlow[脚本更新预览]
        ScriptUpdate["UpdatePreviewViaScript()"]
        ScriptUpdate --> JsonCode["jsonCode = JsonSerializer.Serialize(code)<br/>script = `renderDiagram(${jsonCode})`"]
        JsonCode --> TryExecScript{"_webViewExecuteScriptMethod != null?"}
        TryExecScript -->|是| ExecScript["webViewControl.ExecuteScriptAsync(script)"]
        TryExecScript -->|否| TryCoreWV2{"_coreWebView2ExecuteScriptMethod != null<br/>&& _coreWebView2 != null?"}
        TryCoreWV2 -->|是| ExecCoreWV2["coreWebView2.ExecuteScriptAsync(script)"]
        TryCoreWV2 -->|否| FallbackFull["_webViewPageLoaded = false<br/>_pendingPreviewHtml = 完整 HTML<br/>调用 TryApplyPendingWebPreview()"]
        FallbackFull --> FullReload
    end

    subgraph FullReloadFlow[完整页面重载]
        FullReload["TryApplyPendingWebPreview()"]
        FullReload --> CheckAttached{"_webViewAttached?"}
        CheckAttached -->|否| PendingWait([等待 AttachedToVisualTree])
        CheckAttached -->|是| EnsureFiles["EnsurePreviewFilesReady()"]

        EnsureFiles --> CheckScriptExists{"_previewHtmlPath 已存在?"}
        CheckScriptExists -->|否| CreateDir["创建临时目录<br/>%LOCALAPPDATA%/Diagramon/webpreview/"]
        CreateDir --> CopyScript["从 avares://Diagramon/Assets/mermaid.min.js<br/>复制到临时目录"]
        CopyScript --> WritePreviewFile["File.WriteAllText(_previewHtmlPath, html, UTF-8)"]
        CheckScriptExists -->|是| WritePreviewFile

        WritePreviewFile --> Navigate["_webViewNavigateMethod.Invoke(webView, [uri])<br/>导航到预览 HTML"]
        Navigate --> SetPageLoaded["_webViewPageLoaded = true<br/>_pendingPreviewHtml = null"]
    end

    subgraph InitWebView[WebView 初始化]
        EnsureReady --> CheckExisting{"_previewWebHost.Child 是 WebView?<br/>或 _previewWebViewControl != null?"}
        CheckExisting -->|是| Ready([WebView 就绪])
        CheckExisting -->|否| CheckBounds{"_previewWebHost.Bounds<br/>Width > 0 && Height > 0?"}
        CheckBounds -->|否| DeferInit([延迟初始化])
        CheckBounds -->|是| CheckInitTried{"_webViewInitTried?"}
        CheckInitTried -->|是| DeferInit
        CheckInitTried -->|否| CreateWV["_webViewInitTried = true<br/>new WebView()"]
        CreateWV --> ReflectMethods["反射获取 Navigate / Source / Url /<br/>ExecuteScriptAsync / CoreWebView2"]
        ReflectMethods --> AttachTree["AttachedToVisualTree += 事件"]
        AttachTree --> WaitDelay["延时 500~800ms<br/>获取 CoreWebView2<br/>调用 TryApplyPendingWebPreview()"]
        WaitDelay --> SetChild["_previewWebHost.Child = webViewControl<br/>_previewWebViewControl = webViewControl"]
    end

    subgraph ClientRender[浏览器端渲染]
        WritePreviewFile --> Navigate1["WebView 加载 preview.html"]
        Navigate1 --> RunRenderDiagram["页面加载后自动执行<br/>renderDiagram(mermaidCode)"]

        RunRenderDiagram --> CheckCodeEmptyWV{"code 为空?"}
        CheckCodeEmptyWV -->|是| ClearDiagram["target.innerHTML = ''<br/>清空图表"]
        CheckCodeEmptyWV -->|否| CheckMermaid{"mermaid 已加载?"}
        CheckMermaid -->|否| ShowError["target.innerHTML =<br/>错误信息"]
        CheckMermaid -->|是| MermaidInit["mermaid.initialize({<br/>  startOnLoad: false,<br/>  securityLevel: 'loose',<br/>  theme: 'default'<br/>})"]
        MermaidInit --> RenderSVG["mermaid.render(id, code, container)"]
        RenderSVG --> SetSVG["target.innerHTML = svg"]
        SetSVG --> FitView["requestAnimationFrame<br/>→ fitToViewport()"]

        FitView --> CalcScale["计算缩放比例<br/>使图表居中适配视口<br/>padding = 24px"]
    end

    subgraph Interact[用户交互]
        FitView --> PanZoom["拖拽平移<br/>滚轮缩放<br/>双击适配视口"]
    end

    subgraph ContentEdit[内容编辑]
        EditContent["编辑器输入内容变化"]
        EditContent --> TabContentChanged["TabItem.Content 变更"]
        TabContentChanged --> OnContentChanged["OnTabContentChanged()"]
        OnContentChanged --> SetModified["tab.IsModified = true<br/>tab.UpdateHeader()"]
        SetModified --> ScheduleRender2["ScheduleValidationAndRender(tab)"]
        ScheduleRender2 --> Debounce2["去抖 350ms"]
        Debounce2 --> ScriptUpdate2["ValidateAndRenderTab →<br/>CurrentPreviewHtml 更新 →<br/>UpdatePreviewViaScript()"]
    end

    subgraph CloseTabFlow[关闭标签页]
        CloseCmd["CloseCurrentTab / CloseTab"]
        CloseCmd --> ConfirmClose{"ConfirmCloseTabAsync(tab)<br/>显示保存确认对话框"}
        ConfirmClose -->|取消| CancelClose["StatusMessage = '已取消关闭'"]
        ConfirmClose -->|保存| SaveTab["SaveTabAsync(tab)"]
        ConfirmClose -->|不保存| RemoveHandler["tab.ContentChanged -= OnTabContentChanged"]
        SaveTab --> RemoveHandler

        RemoveHandler --> RemoveFromList["Tabs.RemoveAt(index)"]
        RemoveFromList --> CheckTabsEmpty{"Tabs.Count == 0?"}
        CheckTabsEmpty -->|是| SetSelectedNeg1["SelectedTabIndex = -1<br/>AddNewTab()<br/>创建新的示例标签页"]
        CheckTabsEmpty -->|否| CheckWasSelected{"关闭的是当前选中标签?"}
        CheckWasSelected -->|是| SelectAdjacent["SelectTab(相邻索引, forceNotify: true)"]
        CheckWasSelected -->|否| CheckIndexAdjust{"关闭的标签在选中标签之前?"}
        CheckIndexAdjust -->|是| DecrementIndex["SelectedTabIndex--"]
        CheckIndexAdjust -->|否| UpdateIsSelected["更新剩余标签的 IsSelected 状态"]
    end

    SkipRender --> End
    SkipWV --> End
    PendingWait --> End
    DeferInit --> End
    CancelClose --> End
